# ==============================================================================
# ÉLORA LUXURY BEAUTY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# • Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# • Cloud Deployment (Vercel / Render / Neon / Supabase PostgreSQL):
#   The deployment script (scripts/db-prep.mjs) automatically detects "postgresql://"
#   or "postgres://" URLs, re-configures Prisma, synchronizes schemas, and seeds data.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random secret for production JWT session encryption
AUTH_SECRET="elora_luxury_super_secret_jwt_key_2026_beauty_science"

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENT INTEGRATION (TEST / LIVE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_publishable_key_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder_secret_key_not_real"
STRIPE_WEBHOOK_SECRET="whsec_test_secret_for_webhook_signature_verification"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (GEMINI RAG ENGINE)
# ------------------------------------------------------------------------------
# Optional: Supply Google Gemini API key. If omitted, the platform uses its deterministic
# clinical literature RAG formulation engine.
GEMINI_API_KEY=""
AI_PRIMARY_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# 5. BRAND & STORE FRONT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="ÉLORA"
NEXT_PUBLIC_STORE_TAGLINE="The Science of Beautiful Skin"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
